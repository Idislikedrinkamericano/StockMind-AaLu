{
  "version": "stockmind-eval-v1",
  "data_kind": "synthetic-fixture",
  "fixture_version": "synthetic-v1",
  "description": "12 fixed scripted cases for offline Agent contract regression, not autonomous tool-selection performance or real market data. Expected tools and script are separate fields; wrong-tool-ticker expects no executed tool.",
  "cases": [
    {
      "case_id": "price-nvda",
      "question": "Using fixture data, what is NVDA's latest price? Mark other areas unavailable.",
      "ticker": "NVDA",
      "scenario": "standard",
      "expected_tools": [
        "get_stock_price"
      ],
      "constraints": {
        "report_mode": "grounded",
        "required_metrics": [
          "price"
        ],
        "expected_values": {
          "price": 100
        },
        "unavailable_sections": [
          "financial_analysis",
          "valuation_analysis"
        ]
      },
      "script": [
        {
          "name": "get_stock_price",
          "args": {
            "ticker": "NVDA"
          }
        }
      ]
    },
    {
      "case_id": "trend-amd",
      "question": "Describe AMD's fixture price and the available synthetic history window.",
      "ticker": "AMD",
      "scenario": "standard",
      "expected_tools": [
        "get_stock_price",
        "get_historical_prices"
      ],
      "constraints": {
        "report_mode": "grounded",
        "required_metrics": [
          "price",
          "change"
